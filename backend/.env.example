# SECRETOS Y RUTAS LOCALES
# Copiar este archivo como .env y reemplazar los valores placeholder.
# Este archivo sí puede subirse a Git porque no contiene secretos reales.

# PROVIDER: 'google' u 'ollama'
LLM_PROVIDER=google
AGENT_PROVIDER=google

# GOOGLE CONFIG
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=

# OLLAMA CONFIG
OLLAMA_URL=http://localhost:11434

# MODELOS
GOOGLE_MODEL=gemini-3.1-flash-lite
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_TEMPERATURE=0.1
AGENT_MAX_RETRIES=2

# LANGSMITH
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=dollarcity-assistant

# AGENTE V3
ENABLE_AGENT_V3=true
ENABLE_HITL=false
ENABLE_CONVERSATION_LOGGING=true
ENABLE_LEGACY_CHAT=true
ENABLE_RAG_DEBUG=true

# POSTGRES / POSTGRESSAVER
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dollarcity_agent
CHECKPOINT_TABLE_PREFIX=dollarcity_agent

# CANALES EXTERNOS
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
N8N_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_VERIFY_TOKEN=